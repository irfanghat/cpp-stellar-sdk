#!/bin/bash

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${YELLOW}-----------------------------------------------${NC}"
echo -e "${YELLOW}  Pre-Push Hook: Run Tests ${NC}"
echo -e "${YELLOW}-----------------------------------------------${NC}"
echo ""

current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "detached")

echo -e "${YELLOW}Branch:${NC} $current_branch"
echo -e "${YELLOW}Remote:${NC} $1"
echo ""


echo ""
echo -e "${GREEN}-----------------------------------------------${NC}"
echo -e "${GREEN} ALL TESTS PASSED${NC}"
echo -e "${GREEN}-----------------------------------------------${NC}"
echo -e "${GREEN}Proceeding with push...${NC}"
echo ""

exit 0